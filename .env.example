# Local development defaults only. Copy to .env and never commit secrets.
# No production credentials belong in this file.

NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose service: postgres)
POSTGRES_HOST=localhost
POSTGRES_USER=codearch
POSTGRES_PASSWORD=codearch
POSTGRES_DB=code_archaeologist
POSTGRES_PORT=5432

# Redis (docker compose service: redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth (Phase 1). Use long random values in any shared environment.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Worker
WORKER_CONCURRENCY=2
CREDENTIALS_ENCRYPTION_KEY=local-dev-credentials-secret-change-me-32
# REPOSITORY_WORK_DIR=

# Ollama is optional in Phase 0. Enable with: docker compose --profile ai up -d
# Local RAM guidance: 8GB+ for 7B/8B models, 16GB+ comfortable, 31GB is plenty.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
