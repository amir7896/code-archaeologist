// Code Archaeologist data model.
// Historical evidence links commits to files and symbols with confidence.
// Entity ids are PostgreSQL UUIDs. schema_meta.id stays a stable string.
// Remaining tables follow the project scope later.
// JSONB is reserved for variable metadata. pgvector is not enabled until embeddings are on.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma requires a URL. Scripts and the app build this at runtime from
  // POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, POSTGRES_PORT.
  url      = env("DATABASE_URL")
}

model SchemaMeta {
  id        String   @id @default("code-archaeologist")
  phase     String   @default("8-historical-evidence")
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("schema_meta")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
  GENERIC
}

enum RepositoryStatus {
  PENDING
  SYNCING
  READY
  FAILED
}

enum CredentialType {
  HTTPS_TOKEN
}

enum AnalysisRunType {
  INGESTION
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AnalysisTaskType {
  CLONE
  DETECT_REVISION
  INDEX_HISTORY
  PARSE_AST
  BUILD_GRAPH
  COMPUTE_DNA
  LINK_EVIDENCE
}

enum SymbolKind {
  MODULE
  CLASS
  INTERFACE
  ENUM
  FUNCTION
  METHOD
  VARIABLE
  CONSTANT
  TYPE
  NAMESPACE
}

enum SymbolRelationType {
  IMPORTS
  EXPORTS
  CALLS
  REFERENCES
  EXTENDS
  IMPLEMENTS
}

enum GraphNodeType {
  FILE
  SYMBOL
  MODULE
}

enum GraphEdgeType {
  CONTAINS
  IMPORTS
  EXPORTS
  CALLS
  REFERENCES
  EXTENDS
  IMPLEMENTS
  DEPENDS_ON
}

enum GraphEvidence {
  AST
}

enum DnaSubjectType {
  FILE
  SYMBOL
  MODULE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FileChangeType {
  ADDED
  MODIFIED
  DELETED
  RENAMED
  COPIED
}

enum EvidenceKind {
  COMMIT_SYMBOL
  FILE_COMMIT
}

enum EvidenceMethod {
  LINE_OVERLAP
  FILE_TOUCH
  FILE_ADDED
  FILE_RENAMED
}

enum AnalysisTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  ownedWorkspaces Workspace[]         @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Workspace {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  slug      String          @unique
  ownerId   String          @map("owner_id") @db.Uuid
  settings  Json            @default("{}")
  status    WorkspaceStatus @default(ACTIVE)
  deletedAt DateTime?       @map("deleted_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  auditLogs    AuditLog[]
  repositories Repository[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  resource    String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("timestamp")

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Repository {
  id                  String             @id @default(uuid()) @db.Uuid
  workspaceId         String             @map("workspace_id") @db.Uuid
  name                String
  url                 String
  provider            RepositoryProvider
  defaultBranch       String?            @map("default_branch")
  currentRevision     String?            @map("current_revision")
  lastIndexedRevision String?            @map("last_indexed_revision")
  lastParsedRevision  String?            @map("last_parsed_revision")
  lastGraphRevision   String?            @map("last_graph_revision")
  lastDnaRevision      String?            @map("last_dna_revision")
  lastEvidenceRevision String?            @map("last_evidence_revision")
  settings            Json               @default("{}")
  status              RepositoryStatus   @default(PENDING)
  lastError           String?            @map("last_error")
  lastSyncedAt        DateTime?          @map("last_synced_at")
  deletedAt           DateTime?          @map("deleted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  workspace    Workspace             @relation(fields: [workspaceId], references: [id])
  credential   RepositoryCredential?
  analysisRuns AnalysisRun[]
  developers   Developer[]
  branches     Branch[]
  commits      Commit[]
  files             RepoFile[]
  graphEdges        GraphEdge[]
  metricsSnapshots  MetricsSnapshot[]
  riskScores        RiskScore[]
  evidence          Evidence[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("repositories")
}

model RepositoryCredential {
  id                 String         @id @default(uuid()) @db.Uuid
  repositoryId       String         @unique @map("repository_id") @db.Uuid
  encryptedSecretRef String         @unique @map("encrypted_secret_ref")
  type               CredentialType
  encryptedPayload   String         @map("encrypted_payload")
  keyVersion         Int            @default(1) @map("key_version")
  rotatedAt          DateTime?      @map("rotated_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@map("repository_credentials")
}

model AnalysisRun {
  id           String            @id @default(uuid()) @db.Uuid
  repositoryId String            @map("repository_id") @db.Uuid
  revision     String?
  type         AnalysisRunType
  status       AnalysisRunStatus @default(QUEUED)
  progress     Int               @default(0)
  error        String?
  startedAt    DateTime?         @map("started_at")
  finishedAt   DateTime?         @map("finished_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  repository Repository     @relation(fields: [repositoryId], references: [id])
  tasks      AnalysisTask[]

  @@index([repositoryId, createdAt])
  @@index([status])
  @@map("analysis_runs")
}

model AnalysisTask {
  id            String             @id @default(uuid()) @db.Uuid
  analysisRunId String             @map("analysis_run_id") @db.Uuid
  taskType      AnalysisTaskType   @map("task_type")
  status        AnalysisTaskStatus @default(PENDING)
  attempts      Int                @default(0)
  error         String?
  startedAt     DateTime?          @map("started_at")
  finishedAt    DateTime?          @map("finished_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  run AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@map("analysis_tasks")
}

model Developer {
  id              String   @id @default(uuid()) @db.Uuid
  repositoryId    String   @map("repository_id") @db.Uuid
  canonicalName   String   @map("canonical_name")
  canonicalEmail  String   @map("canonical_email")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id])
  commits    Commit[]

  @@unique([repositoryId, canonicalEmail])
  @@index([repositoryId])
  @@map("developers")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  name         String
  headCommitId String?  @map("head_commit_id") @db.Uuid
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository     @relation(fields: [repositoryId], references: [id])
  headCommit Commit?        @relation("BranchHead", fields: [headCommitId], references: [id], onDelete: SetNull)
  commits    BranchCommit[]

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("branches")
}

model Commit {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  sha          String
  message      String
  authorName   String   @map("author_name")
  authorEmail  String   @map("author_email")
  authoredAt   DateTime @map("authored_at")
  committedAt  DateTime @map("committed_at")
  parentShas   String[] @map("parent_shas")
  isMerge      Boolean  @default(false) @map("is_merge")
  developerId  String?  @map("developer_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  repository     Repository     @relation(fields: [repositoryId], references: [id])
  developer      Developer?     @relation(fields: [developerId], references: [id], onDelete: SetNull)
  files          CommitFile[]
  branches       BranchCommit[]
  headOfBranches Branch[]       @relation("BranchHead")
  symbolVersions SymbolVersion[]
  evidence       Evidence[]

  @@unique([repositoryId, sha])
  @@index([repositoryId, committedAt])
  @@index([developerId])
  @@map("commits")
}

model BranchCommit {
  branchId String @map("branch_id") @db.Uuid
  commitId String @map("commit_id") @db.Uuid

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@id([branchId, commitId])
  @@index([commitId])
  @@map("branch_commits")
}

model RepoFile {
  id                 String   @id @default(uuid()) @db.Uuid
  repositoryId       String   @map("repository_id") @db.Uuid
  path               String
  language           String?
  hash               String?
  size               Int?
  loc                Int?
  complexity         Int?
  firstRevision      String   @map("first_revision")
  lastRevision       String   @map("last_revision")
  lastParsedRevision String?  @map("last_parsed_revision")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  repository  Repository   @relation(fields: [repositoryId], references: [id])
  commitFiles    CommitFile[]
  symbols        CodeSymbol[]
  symbolVersions SymbolVersion[]
  evidence       Evidence[]

  @@unique([repositoryId, path])
  @@index([repositoryId])
  @@map("files")
}

model CommitFile {
  id           String         @id @default(uuid()) @db.Uuid
  commitId     String         @map("commit_id") @db.Uuid
  fileId       String         @map("file_id") @db.Uuid
  changeType   FileChangeType @map("change_type")
  oldPath      String?        @map("old_path")
  newPath      String         @map("new_path")
  additions    Int            @default(0)
  deletions    Int            @default(0)
  similarity   Int?
  patchPreview String?        @map("patch_preview")

  commit Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  file   RepoFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([commitId, fileId])
  @@index([fileId])
  @@map("commit_files")
}

model CodeSymbol {
  id                 String     @id @default(uuid()) @db.Uuid
  fileId             String     @map("file_id") @db.Uuid
  parentSymbolId     String?    @map("parent_symbol_id") @db.Uuid
  kind               SymbolKind
  name               String
  qualifiedName      String     @map("qualified_name")
  startLine          Int        @map("start_line")
  endLine            Int        @map("end_line")
  astHash            String     @map("ast_hash")
  loc                Int        @default(0)
  complexity         Int        @default(0)
  nesting            Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  file     RepoFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parent   CodeSymbol?       @relation("SymbolTree", fields: [parentSymbolId], references: [id], onDelete: SetNull)
  children CodeSymbol[]      @relation("SymbolTree")
  outgoing SymbolRelation[]  @relation("RelationSource")
  incoming SymbolRelation[]  @relation("RelationTarget")
  versions SymbolVersion[]
  evidence Evidence[]

  @@unique([fileId, qualifiedName])
  @@index([fileId])
  @@index([qualifiedName])
  @@index([kind])
  @@map("symbols")
}

model SymbolRelation {
  id                  String              @id @default(uuid()) @db.Uuid
  sourceSymbolId      String              @map("source_symbol_id") @db.Uuid
  targetSymbolId      String?             @map("target_symbol_id") @db.Uuid
  targetQualifiedName String              @map("target_qualified_name")
  type                SymbolRelationType
  confidence          Float
  createdAt           DateTime            @default(now()) @map("created_at")

  source CodeSymbol  @relation("RelationSource", fields: [sourceSymbolId], references: [id], onDelete: Cascade)
  target CodeSymbol? @relation("RelationTarget", fields: [targetSymbolId], references: [id], onDelete: SetNull)

  @@index([sourceSymbolId])
  @@index([targetSymbolId])
  @@index([type])
  @@map("symbol_relations")
}

model GraphEdge {
  id            String         @id @default(uuid()) @db.Uuid
  repositoryId  String         @map("repository_id") @db.Uuid
  sourceType    GraphNodeType  @map("source_type")
  sourceId      String         @map("source_id")
  targetType    GraphNodeType  @map("target_type")
  targetId      String?        @map("target_id")
  targetKey     String         @map("target_key")
  type          GraphEdgeType  @map("edge_type")
  confidence    Float
  evidence      GraphEvidence  @default(AST)
  firstRevision String         @map("first_revision")
  lastRevision  String         @map("last_revision")
  createdAt     DateTime       @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sourceType, sourceId, type, targetType, targetKey], map: "graph_edges_unique")
  @@index([repositoryId, type], map: "graph_edges_repo_type_idx")
  @@index([sourceId], map: "graph_edges_source_idx")
  @@index([targetId], map: "graph_edges_target_idx")
  @@map("graph_edges")
}

model SymbolVersion {
  id            String         @id @default(uuid()) @db.Uuid
  fileId        String         @map("file_id") @db.Uuid
  qualifiedName String         @map("qualified_name")
  symbolId      String?        @map("symbol_id") @db.Uuid
  commitId      String?        @map("commit_id") @db.Uuid
  revision      String
  contentHash   String         @map("content_hash")
  startLine     Int            @map("start_line")
  endLine       Int            @map("end_line")
  loc           Int            @default(0)
  complexity    Int            @default(0)
  nesting       Int            @default(0)
  changeType    FileChangeType @map("change_type")
  createdAt     DateTime       @default(now()) @map("created_at")

  file   RepoFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  symbol CodeSymbol? @relation(fields: [symbolId], references: [id], onDelete: SetNull)
  commit Commit?     @relation(fields: [commitId], references: [id], onDelete: SetNull)

  @@unique([fileId, qualifiedName, revision], map: "symbol_versions_unique")
  @@index([fileId], map: "symbol_versions_file_idx")
  @@index([symbolId], map: "symbol_versions_symbol_idx")
  @@index([commitId], map: "symbol_versions_commit_idx")
  @@map("symbol_versions")
}

model MetricsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  revision     String
  scope        String
  subjectId    String   @map("subject_id")
  metrics      Json     @map("metrics_json")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, revision, scope, subjectId], map: "metrics_snapshots_unique")
  @@index([repositoryId, scope], map: "metrics_snapshots_repo_scope_idx")
  @@map("metrics_snapshots")
}

model RiskScore {
  id                  String         @id @default(uuid()) @db.Uuid
  repositoryId        String         @map("repository_id") @db.Uuid
  subjectType         DnaSubjectType @map("subject_type")
  subjectId           String         @map("subject_id")
  revision            String
  score               Float
  level               RiskLevel
  factors             Json           @map("factors_json")
  evidenceConfidence  Float          @map("evidence_confidence")
  calculatedAt        DateTime       @default(now()) @map("calculated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, subjectType, subjectId], map: "risk_scores_unique")
  @@index([repositoryId, level], map: "risk_scores_repo_level_idx")
  @@map("risk_scores")
}

model Evidence {
  id           String         @id @default(uuid()) @db.Uuid
  repositoryId String         @map("repository_id") @db.Uuid
  kind         EvidenceKind
  method       EvidenceMethod
  subjectType  DnaSubjectType @map("subject_type")
  subjectId    String         @map("subject_id")
  sourceType   String         @map("source_type")
  sourceId     String         @map("source_id")
  commitId     String?        @map("commit_id") @db.Uuid
  fileId       String?        @map("file_id") @db.Uuid
  symbolId     String?        @map("symbol_id") @db.Uuid
  confidence   Float
  excerpt      String?
  details      Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at")

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commit     Commit?     @relation(fields: [commitId], references: [id], onDelete: Cascade)
  file       RepoFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  symbol     CodeSymbol? @relation(fields: [symbolId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, kind, subjectId, sourceId], map: "evidence_unique")
  @@index([repositoryId, subjectType, subjectId], map: "evidence_subject_idx")
  @@index([commitId], map: "evidence_commit_idx")
  @@map("evidence")
}

