{
  "name": "@code-archaeologist/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "node scripts/run-prisma.cjs generate && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "node scripts/run-prisma.cjs generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/run-prisma.cjs generate",
    "db:migrate": "node scripts/run-prisma.cjs migrate dev",
    "db:migrate:deploy": "node scripts/run-prisma.cjs migrate deploy",
    "db:seed": "node prisma/seed.cjs",
    "postinstall": "node scripts/run-prisma.cjs generate"
  },
  "dependencies": {
    "@code-archaeologist/shared": "workspace:*",
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
