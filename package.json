{
  "name": "code-archaeologist",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI system that reconstructs not only what a codebase does, but why it evolved into its current architecture.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "pnpm --filter @code-archaeologist/shared --filter @code-archaeologist/core --filter @code-archaeologist/parser --filter @code-archaeologist/git --filter @code-archaeologist/ai --filter @code-archaeologist/sdk --filter @code-archaeologist/cli build",
    "dev": "concurrently -n pkg,api,worker,web -c blue,green,yellow,magenta \"pnpm dev:packages\" \"pnpm --filter @code-archaeologist/api dev\" \"pnpm --filter @code-archaeologist/worker dev\" \"pnpm --filter @code-archaeologist/web dev\"",
    "dev:packages": "pnpm --filter @code-archaeologist/shared --filter @code-archaeologist/core --filter @code-archaeologist/parser --filter @code-archaeologist/git --filter @code-archaeologist/ai --parallel build:watch",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose stop postgres redis",
    "build": "pnpm --filter @code-archaeologist/shared --filter @code-archaeologist/core --filter @code-archaeologist/parser --filter @code-archaeologist/git --filter @code-archaeologist/ai --filter @code-archaeologist/sdk --filter @code-archaeologist/cli --filter @code-archaeologist/api --filter @code-archaeologist/worker --filter @code-archaeologist/web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @code-archaeologist/shared --filter @code-archaeologist/parser --filter @code-archaeologist/git --filter @code-archaeologist/ai --filter @code-archaeologist/core --filter @code-archaeologist/sdk --filter @code-archaeologist/cli build && pnpm --filter @code-archaeologist/api --filter @code-archaeologist/worker --filter @code-archaeologist/web typecheck",
    "pretest": "pnpm --filter @code-archaeologist/shared --filter @code-archaeologist/core --filter @code-archaeologist/parser --filter @code-archaeologist/git --filter @code-archaeologist/ai build",
    "test": "pnpm --recursive --if-present test",
    "db:generate": "pnpm --filter @code-archaeologist/core db:generate",
    "db:migrate": "pnpm --filter @code-archaeologist/core db:migrate",
    "db:migrate:deploy": "pnpm --filter @code-archaeologist/core db:migrate:deploy",
    "db:seed": "pnpm --filter @code-archaeologist/core db:seed",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "pnpm --recursive exec rm -rf dist coverage .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
